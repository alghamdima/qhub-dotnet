@page "/error"
@using Microsoft.Extensions.Options
@using Qhub.Configuration
@using Qhub.Features.Portal
@inject CustomerTexts Texts
@inject IOptions<QhubOptions> Options
@* Legacy template html_error, the "link not valid" case (ErrorId 0). The SAML case arrives with Phase 3 identity. *@
@{
    Response.Headers.CacheControl = "no-store, no-cache";
    var customer = Texts.For(Request);
    ViewData["PublicName"] = Options.Value.PublicName;
    ViewData["PageName"] = "PublicError";
}
@section Head {
         <title>@Options.Value.PublicName</title>
}
     <div class="row justify-content-center mt-5">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body text-center">
      <div lang="@customer.Lang" dir="@customer.Dir">
        <h2 class="card-title">@customer.T["linkInvalidTitle"]</h2>
        <p class="mt-3 mb-0">@customer.T["linkInvalidText"]</p>
      </div>
      </div>
    </div>
  </div>
</div>

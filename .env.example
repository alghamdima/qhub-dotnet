# Qhub settings for compose.yaml. Copy to .env (deploy/make-secrets.sh does it for you), then: docker compose up -d
# Every value is read once at startup. After an edit run `docker compose up -d` (it recreates the container);
# `docker compose restart` does NOT pick up changes to this file. No rebuild is needed.
# The app checks every value at startup and stops with the full list of problems (docker compose logs qhub).
# Keep this file private: it is gitignored, and its values are visible in `docker inspect`.

# ── Compose itself (not read by the app) ────────────────────────────────────
# SQL Server's sa password; also inside deploy/secrets/db_connection. Only used when the database volume is first created.
QHUB_SQL_SA_PASSWORD=
# Port on this machine; the app listens on 8080 inside the container.
QHUB_HOST_PORT=8080

# ── Server ──────────────────────────────────────────────────────────────────
# The exact address users open Qhub at; links and QR codes use it. Must be https:// on a real host.
# Left empty, compose uses http://localhost:<QHUB_HOST_PORT>/ for local testing.
#QHUB_PUBLIC_URL=https://files.example.com/
QHUB_PUBLIC_NAME=Qhub
# Where the start page goes, e.g. the company website; empty opens the login page.
#QHUB_REDIRECT_URL=
# Behind a reverse proxy or load balancer: its addresses or CIDR ranges, comma separated, so the customer's IP
# is read from X-Forwarded-For.
#QHUB_TRUSTED_PROXIES=127.0.0.1

# ── Sign-in ─────────────────────────────────────────────────────────────────
# Only "internal" for now (SAML is deferred; "saml" is refused at startup).
#QHUB_AUTH=internal
# The super admin is created or updated from these at every start. Password: deploy/secrets/admin_password.
QHUB_ADMIN_USER=admin
#QHUB_MIN_LENGTH_PASSWORD=8
# true hides the API page from users who are not admins.
#QHUB_DISABLE_API_MENU=false

# ── Uploads and links ───────────────────────────────────────────────────────
# Largest document in MB.
#QHUB_MAX_FILESIZE=50
#QHUB_CHUNK_SIZE_MB=45
#QHUB_MAX_MEMORY_UPLOAD=50
#QHUB_MAX_PARALLEL_UPLOADS=3
# Uploads are refused when less than this many MB are free on the data volume.
#QHUB_MIN_FREE_SPACE=400
# Characters in a link ID (5 to 64).
#QHUB_LENGTH_ID=15

# ── Logging ─────────────────────────────────────────────────────────────────
# Days to keep the audit log; 0 keeps it forever.
#QHUB_LOG_RETENTION_DAYS=0
# true records the IP of each download and wrong code in the audit log.
#QHUB_SAVE_IP=false

# ── Encryption at rest (local storage only) ─────────────────────────────────
# none or on. Choose it once: Qhub refuses to start if it changes while encrypted files exist.
#QHUB_ENCRYPTION=none
# Required with "on" (at least QHUB_MIN_LENGTH_PASSWORD characters). Qhub never stores it; without it the files
# are lost, so keep a copy apart from the backups. Prefer the _FILE form (see README, "Secrets").
#QHUB_ENCRYPTION_PASSWORD=

# ── S3-compatible storage (written, not yet tested against a real bucket) ───
# Files stay on the data volume unless a bucket is set. With a bucket, use the bucket's own encryption
# and keep QHUB_ENCRYPTION=none.
#QHUB_AWS_BUCKET=
#QHUB_AWS_REGION=
#QHUB_AWS_KEY=
#QHUB_AWS_KEY_SECRET=
#QHUB_AWS_ENDPOINT=
# true streams downloads through Qhub instead of redirecting to a signed bucket URL.
#QHUB_AWS_PROXY_DOWNLOAD=false

# ── Set by compose.yaml, do not set here ────────────────────────────────────
# QHUB_DB_CONNECTION_FILE, QHUB_SERVER_KEY_FILE, QHUB_ADMIN_PASSWORD_FILE, QHUB_DATA_PROTECTION_CERT_FILE (deploy/secrets/*)
# QHUB_PORT=8080 and QHUB_DATA_DIR=/data (fixed in the image)
